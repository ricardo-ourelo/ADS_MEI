<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sistema Interativo de Rotas</title>

    <!-- Leaflet CSS -->
    <link
            rel="stylesheet"
            href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />

    <!-- geral style -->
    <link rel="stylesheet" href="/css/panel.css" />
    <!-- style panel -->
    <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
<div id="page-map">
    <aside>
        <header>
            <img src="images/map-marker.svg" alt="Happy" />
            <h2>Escolha um lugar no mapa</h2>
        </header>
            <!-- NOVO: seletor de tema -->
            <div class="theme-selector">
                <label for="theme-select">Tema do painel:</label>
                <select id="theme-select">
                    <option value="ocean">🌊 Ocean (Padrão)</option>
                    <option value="light">☀️ Claro</option>
                    <option value="dark">🌙 Escuro</option>
                    <option value="forest">🌲 Floresta</option>
                    <option value="sunset">🌅 Pôr do Sol</option>
                </select>
            </div>

            <!-- Campos panel lateral-->
        <div class="search-form">
            <div class="input-group">
                <label for="start">Origem:</label>
                <div class="input-with-button">
                    <input type="text" id="start" placeholder="Digite o endereço de origem">
                    <button type="button" id="search-start-btn" class="search-btn">🔍</button>
                </div>
            </div>

            <div class="input-group">
                <label for="stops-container">Paragens intermédias:</label>
                <div id="stops-container"></div>
                <button type="button" id="add-stop-btn" class="btn-primary" style="margin-top: 8px;">
                    + Adicionar paragem
                </button>
            </div>

            <div class="input-group">
                <label for="end">Destino:</label>
                <div class="input-with-button">
                    <input type="text" id="end" placeholder="Digite o endereço de destino">
                    <button type="button" id="search-end-btn" class="search-btn">🔍</button>
                </div>
            </div>

            <div class="profile-selector">
                <label>Perfil de Rota:</label>
                <select id="profile">
                    <option value="car">🚗 Carro (50 km/h)</option>
                    <option value="mota">🏍️ Mota (60 km/h)</option>
                    <option value="bicicleta">🚴 Bicicleta (15 km/h)</option>
                    <option value="walking">🚶 A Pé (5 km/h)</option>
                </select>
            </div>

            <div class="actions">
                <button id="calculate-route-btn" class="btn-primary">Calcular Rota</button>
                <button id="clear-route-btn" class="btn-secondary">Limpar Tudo</button>
            </div>
        </div>

        <div id="route-info" class="route-info">
            <h3>📊 Informações da Rota</h3>
            <div id="distance" class="info-item"></div>
            <div id="duration" class="info-item"></div>
        </div>

        <div id="search-results" class="search-results"></div>


        <div id="route-controls" class="route-controls minimal-pois">
            <div class="poi-bar">
                <button class="poi-icon" data-type="restaurant" title="Restaurantes">🍽️</button>
                <button class="poi-icon" data-type="cafe" title="Cafés">☕</button>
                <button class="poi-icon" data-type="hotel" title="Hotéis">🏨</button>
                <button class="poi-icon" data-type="bank" title="Bancos">🏦</button>
                <button class="poi-icon" data-type="pharmacy" title="Farmácias">💊</button>
                <button class="poi-icon" data-type="hospital" title="Hospitais">🏥</button>
                <button class="poi-icon" data-type="fuel" title="Postos">⛽</button>
                <button class="poi-icon" data-type="parking" title="Estacionamento">🅿️</button>
                <button class="poi-icon" data-type="supermarket" title="Supermercados">🛒</button>
                <button class="poi-icon" data-type="park" title="Parques">🌳</button>
            </div>

            <button id="clear-pois-btn" class="clear-pois-btn" title="Limpar POIs">🗑️</button>
        </div>

